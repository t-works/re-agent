{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  // State dirs are data, not source: agents write .ts into memory/ workspaces
  "exclude": ["node_modules", "dist", "memory", "runtime"]
}
